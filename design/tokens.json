{
  "$description": "Blueprint design tokens · Direction 04 'Annotated'. W3C DTCG format. Primitives hold raw values; theme.dark and theme.light map them to semantic roles. Components use semantic tokens only.",

  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0":   { "$value": "#FFFFFF" },
        "50":  { "$value": "#F4F4F1" },
        "75":  { "$value": "#F0EFEA" },
        "100": { "$value": "#ECEBE5" },
        "200": { "$value": "#DEDDD6" },
        "300": { "$value": "#C9C8C0" },
        "400": { "$value": "#A3A29A" },
        "500": { "$value": "#6B6A64" },
        "600": { "$value": "#45443F" },
        "700": { "$value": "#3A3A36" },
        "750": { "$value": "#30312D" },
        "800": { "$value": "#232421" },
        "850": { "$value": "#1B1B19" },
        "900": { "$value": "#171816" },
        "925": { "$value": "#121311" },
        "950": { "$value": "#0A0A09" }
      },
      "forest": {
        "50":  { "$value": "#E3EEE7" },
        "200": { "$value": "#9FD6B6" },
        "300": { "$value": "#7DC59C" },
        "600": { "$value": "#2F6B4F" },
        "700": { "$value": "#1F4A36" },
        "950": { "$value": "#0F1512" }
      },
      "amber": {
        "50":  { "$value": "#FBF6D6" },
        "200": { "$value": "#F2E27A" },
        "300": { "$value": "#E8C95A" },
        "600": { "$value": "#B08A00" },
        "700": { "$value": "#6B5A00" },
        "900": { "$value": "#4A4224" },
        "950": { "$value": "#2A2819" }
      },
      "red": {
        "300": { "$value": "#F08A7E" },
        "700": { "$value": "#B3261E" },
        "950": { "$value": "#2E1A17" },
        "50":  { "$value": "#FBE9E6" }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "display": { "$value": ["Newsreader", "Georgia", "serif"] },
        "ui":      { "$value": ["Geist", "system-ui", "sans-serif"] },
        "mono":    { "$value": ["Geist Mono", "ui-monospace", "monospace"] }
      },
      "weight": {
        "$type": "fontWeight",
        "regular":  { "$value": 400 },
        "medium":   { "$value": 500 },
        "semibold": { "$value": 600 }
      },
      "size": {
        "$type": "dimension",
        "xs":   { "$value": "12px" },
        "sm":   { "$value": "13px" },
        "base": { "$value": "14px" },
        "md":   { "$value": "15px" },
        "lg":   { "$value": "17px" },
        "xl":   { "$value": "20px" },
        "2xl":  { "$value": "24px" },
        "3xl":  { "$value": "32px" },
        "4xl":  { "$value": "44px" },
        "5xl":  { "$value": "60px" },
        "gym":  { "$value": "76px" }
      }
    }
  },

  "theme": {
    "dark": {
      "$description": "Default theme.",
      "color": {
        "$type": "color",
        "bg":             { "$value": "{primitive.color.neutral.925}" },
        "bg-grid":        { "$value": "{primitive.color.neutral.900}" },
        "surface":        { "$value": "{primitive.color.neutral.850}" },
        "surface-raised": { "$value": "{primitive.color.neutral.800}" },
        "border":         { "$value": "{primitive.color.neutral.750}" },
        "border-strong":  { "$value": "{primitive.color.neutral.100}" },
        "border-input":   { "$value": "#706F68", "$description": "Form field edges: 3:1 against bg and surface (WCAG 1.4.11)." },
        "text":           { "$value": "{primitive.color.neutral.100}" },
        "text-secondary": { "$value": "{primitive.color.neutral.300}" },
        "text-muted":     { "$value": "{primitive.color.neutral.400}" },
        "text-inverse":   { "$value": "{primitive.color.neutral.925}" },
        "accent":         { "$value": "{primitive.color.forest.300}" },
        "accent-fg":      { "$value": "{primitive.color.forest.950}" },
        "link":           { "$value": "{primitive.color.forest.200}" },
        "ai":             { "$value": "{primitive.color.amber.300}" },
        "ai-text":        { "$value": "{primitive.color.amber.300}" },
        "ai-wash":        { "$value": "{primitive.color.amber.950}" },
        "ai-mark":        { "$value": "{primitive.color.amber.900}" },
        "danger":         { "$value": "{primitive.color.red.300}" },
        "danger-wash":    { "$value": "{primitive.color.red.950}" },
        "focus":          { "$value": "{primitive.color.forest.300}" },
        "chart-line":     { "$value": "{primitive.color.neutral.100}" },
        "chart-series-2": { "$value": "{primitive.color.forest.300}" },
        "chart-grid":     { "$value": "{primitive.color.neutral.750}" },
        "chart-band":     { "$value": "{primitive.color.amber.950}" },
        "gym-bg":         { "$value": "{primitive.color.neutral.950}" },
        "gym-text":       { "$value": "{primitive.color.neutral.100}" },
        "gym-muted":      { "$value": "{primitive.color.neutral.400}" },
        "gym-track":      { "$value": "{primitive.color.neutral.750}" }
      },
      "shadow": {
        "$type": "shadow",
        "popover": { "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "#00000066" } }
      }
    },
    "light": {
      "color": {
        "$type": "color",
        "bg":             { "$value": "{primitive.color.neutral.50}" },
        "bg-grid":        { "$value": "{primitive.color.neutral.100}" },
        "surface":        { "$value": "{primitive.color.neutral.0}" },
        "surface-raised": { "$value": "{primitive.color.neutral.75}" },
        "border":         { "$value": "{primitive.color.neutral.200}" },
        "border-strong":  { "$value": "{primitive.color.neutral.850}" },
        "border-input":   { "$value": "#8A8982", "$description": "Form field edges: 3:1 against bg and surface (WCAG 1.4.11)." },
        "text":           { "$value": "{primitive.color.neutral.850}" },
        "text-secondary": { "$value": "{primitive.color.neutral.600}" },
        "text-muted":     { "$value": "{primitive.color.neutral.500}" },
        "text-inverse":   { "$value": "{primitive.color.neutral.0}" },
        "accent":         { "$value": "{primitive.color.forest.600}" },
        "accent-fg":      { "$value": "{primitive.color.neutral.0}" },
        "link":           { "$value": "{primitive.color.forest.600}" },
        "ai":             { "$value": "{primitive.color.amber.600}" },
        "ai-text":        { "$value": "{primitive.color.amber.700}" },
        "ai-wash":        { "$value": "{primitive.color.amber.50}" },
        "ai-mark":        { "$value": "{primitive.color.amber.200}" },
        "danger":         { "$value": "{primitive.color.red.700}" },
        "danger-wash":    { "$value": "{primitive.color.red.50}" },
        "focus":          { "$value": "{primitive.color.forest.600}" },
        "chart-line":     { "$value": "{primitive.color.neutral.850}" },
        "chart-series-2": { "$value": "{primitive.color.forest.600}" },
        "chart-grid":     { "$value": "{primitive.color.neutral.200}" },
        "chart-band":     { "$value": "{primitive.color.amber.50}" },
        "gym-bg":         { "$value": "{primitive.color.neutral.850}" },
        "gym-text":       { "$value": "{primitive.color.neutral.50}" },
        "gym-muted":      { "$value": "{primitive.color.neutral.400}" },
        "gym-track":      { "$value": "{primitive.color.neutral.700}" }
      },
      "shadow": {
        "$type": "shadow",
        "popover": { "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "#1B1B191F" } }
      }
    }
  },

  "typography": {
    "$type": "typography",
    "display-hero":  { "$value": { "fontFamily": "{primitive.font.family.display}", "fontWeight": 500, "fontSize": "{primitive.font.size.5xl}", "lineHeight": 1.0,  "letterSpacing": "-0.02em" } },
    "display-page":  { "$value": { "fontFamily": "{primitive.font.family.display}", "fontWeight": 500, "fontSize": "{primitive.font.size.4xl}", "lineHeight": 1.05, "letterSpacing": "-0.02em" } },
    "display-section": { "$value": { "fontFamily": "{primitive.font.family.display}", "fontWeight": 500, "fontSize": "{primitive.font.size.3xl}", "lineHeight": 1.15, "letterSpacing": "-0.01em" } },
    "insight":       { "$value": { "fontFamily": "{primitive.font.family.display}", "fontWeight": 400, "fontSize": "{primitive.font.size.2xl}", "lineHeight": 1.3,  "letterSpacing": "0" } },
    "reasoning":     { "$value": { "fontFamily": "{primitive.font.family.display}", "fontWeight": 400, "fontSize": "{primitive.font.size.lg}",  "lineHeight": 1.45, "letterSpacing": "0", "fontStyle": "italic" } },
    "ui-title":      { "$value": { "fontFamily": "{primitive.font.family.ui}", "fontWeight": 600, "fontSize": "{primitive.font.size.md}",   "lineHeight": 1.3, "letterSpacing": "0" } },
    "ui-label":      { "$value": { "fontFamily": "{primitive.font.family.ui}", "fontWeight": 500, "fontSize": "{primitive.font.size.base}", "lineHeight": 1.3, "letterSpacing": "0" } },
    "ui-body":       { "$value": { "fontFamily": "{primitive.font.family.ui}", "fontWeight": 400, "fontSize": "{primitive.font.size.md}",   "lineHeight": 1.6, "letterSpacing": "0" } },
    "ui-caption":    { "$value": { "fontFamily": "{primitive.font.family.ui}", "fontWeight": 400, "fontSize": "{primitive.font.size.sm}",   "lineHeight": 1.45, "letterSpacing": "0" } },
    "eyebrow":       { "$value": { "fontFamily": "{primitive.font.family.mono}", "fontWeight": 400, "fontSize": "{primitive.font.size.xs}", "lineHeight": 1.3, "letterSpacing": "0.08em", "textTransform": "uppercase" } },
    "data":          { "$value": { "fontFamily": "{primitive.font.family.mono}", "fontWeight": 500, "fontSize": "{primitive.font.size.base}", "lineHeight": 1.4, "letterSpacing": "0" } },
    "data-lg":       { "$value": { "fontFamily": "{primitive.font.family.mono}", "fontWeight": 500, "fontSize": "{primitive.font.size.2xl}",  "lineHeight": 1.2, "letterSpacing": "0" } },
    "gym-numeral":   { "$value": { "fontFamily": "{primitive.font.family.display}", "fontWeight": 500, "fontSize": "{primitive.font.size.gym}", "lineHeight": 0.9, "letterSpacing": "-0.03em" } }
  },

  "space": {
    "$type": "dimension",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "14": { "$value": "56px" },
    "16": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "xs":   { "$value": "4px",   "$description": "Tags, kbd hints" },
    "sm":   { "$value": "6px",   "$description": "Small buttons, inputs, segmented items" },
    "md":   { "$value": "8px",   "$description": "Buttons, AI proposal boxes" },
    "lg":   { "$value": "10px",  "$description": "Cards, panels, nav bar" },
    "xl":   { "$value": "14px",  "$description": "Gym-mode primary button" },
    "2xl":  { "$value": "28px",  "$description": "Gym-mode sheet" },
    "full": { "$value": "999px" }
  },

  "border": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "ai":       { "$value": "1.5px", "$description": "Always dashed. Reserved for AI-proposed content." },
    "focus":    { "$value": "2px" }
  },

  "size": {
    "$type": "dimension",
    "control-sm": { "$value": "36px" },
    "control-md": { "$value": "44px", "$description": "Default; also the minimum touch target" },
    "control-lg": { "$value": "60px", "$description": "Gym mode" },
    "content-max": { "$value": "1280px" },
    "reading-max": { "$value": "640px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms", "$description": "AI highlight ink-in" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "exit":     { "$value": [0.4, 0, 1, 1] }
    }
  }
}
